# ======== AI 模型配置 ========
# DeepSeek（唯一在用模型）
# 前往 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# ======== MySQL 配置 ========
# 方式一：单连接串（推荐，Railway/Render 等托管服务通常提供）
# 格式：mysql://user:password@host:port/database
# DATABASE_URL=mysql://user:password@host:port/database

# 方式二：逐个变量
# 本地开发默认 127.0.0.1:3306，生产请替换为云端 MySQL 公网地址
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASS=your_mysql_password
DB_NAME=aichat

# ======== 安全与部署 ========
# CORS 允许来源（逗号分隔），示例：https://aichat.example.com
# 已内置：localhost:5173/4173 + *.vercel.app（Vercel 预览/生产）
CORS_ORIGINS=

# ======== 前端（Vercel）环境变量 ========
# 在 Vercel 项目 Settings → Environment Variables 中配置。
# 后端 Express + MySQL 的公网地址（Vercel 不运行后端），例如：https://aichat-api.example.com
# 开发环境无需设置，Vite dev proxy 会自动把 /api 代理到 http://localhost:3001
VITE_API_BASE_URL=

# ======== Cloudflare R2 图片存储配置 ========
# 不配置时跳过 R2 上传，图片仅存 localStorage（刷新可能丢失）
# 前往 Cloudflare Dashboard → R2 创建 bucket 和 API Token
# R2_PUBLIC_URL 是 bucket 的公开访问域名（建议绑定自定义域名或使用 R2 dev URL）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
