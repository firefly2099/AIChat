# ======== AI 模型配置 ========
# DeepSeek（唯一在用模型）
# 前往 https://platform.deepseek.com/api_keys 申请
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# ======== MySQL 配置 ========
# 本地开发默认 127.0.0.1:3306，生产请替换为云端 MySQL 公网地址
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=aichat

# ======== 安全与部署 ========
# CORS 允许来源（逗号分隔），示例：https://aichat.example.com
# 已内置：localhost:5173/4173 + *.vercel.app（Vercel 预览/生产）
CORS_ORIGINS=

# ======== 前端（Vercel）环境变量 ========
# 在 Vercel 项目 Settings → Environment Variables 中配置。
# 后端 Express + MySQL 的公网地址（Vercel 不运行后端），例如：https://aichat-api.example.com
# 开发环境无需设置，Vite dev proxy 会自动把 /api 代理到 http://localhost:3001
VITE_API_BASE_URL=
